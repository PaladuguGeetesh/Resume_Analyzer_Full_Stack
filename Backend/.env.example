# Combined-process mode: set to "true" only on deployments (e.g. Render's free tier)
# without separate worker services. Leave unset for local dev — run `npm run
# worker:reports` / `npm run worker:resumes` as their own processes instead, same as always.
RUN_WORKER_IN_PROCESS=
RUN_RESUME_WORKER_IN_PROCESS=


# "gemini" or "groq" — picks the primary AI provider (ai.service.js); the other one is
# the automatic fallback once the shared circuit breaker trips.
AI_PRIMARY_PROVIDER=

GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=

MONGO_URI=
REDIS_URL=
JWT_SECRET=

# The deployed frontend's origin (e.g. the Vercel URL) — used for CORS. Falls back to
# http://localhost:5173 if unset, so this is only required in production.
FRONTEND_URL=

NODE_ENV=
PORT=
